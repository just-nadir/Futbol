# Telegram bot (BotFather orqali olinadi)
TELEGRAM_BOT_TOKEN=
# O'zingiz o'ylab topgan tasodifiy uzun matn (masalan: openssl rand -hex 32)
TELEGRAM_WEBHOOK_SECRET=
# "Futbol" guruhining chat id'si (manfiy son, masalan -1001234567890)
TELEGRAM_GROUP_CHAT_ID=

# Supabase loyihasi sozlamalaridan (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Deploy qilingandan keyingi to'liq HTTPS manzil (masalan https://futbol.vercel.app)
NEXT_PUBLIC_APP_URL=

# Vercel Cron so'rovlarini tekshirish uchun tasodifiy matn
CRON_SECRET=
